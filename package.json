{
  "name": "express-drizzle-boilerplate",
  "version": "1.0.0",
  "description": "Boilerplate backend Express + Drizzle ORM (MySQL) + TypeScript",
  "main": "build/index.js",
  "private": true,
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/index.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier ./src --write",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node build/database/migrate.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "ts-node src/database/seed.ts",
    "prepare": "husky",
    "postbuild": "node -e \"require('fs').cpSync('src/database/migrations','build/database/migrations',{recursive:true})\""
  },
  "keywords": [
    "express",
    "drizzle",
    "mysql",
    "typescript",
    "boilerplate"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "module-alias": "^2.3.4",
    "mysql2": "^3.24.5",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^26.6.4",
    "@types/request-ip": "^0.0.41",
    "drizzle-kit": "^0.31.11",
    "husky": "^9.1.7",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
