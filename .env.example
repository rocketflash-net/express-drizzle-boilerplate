# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Express Drizzle Service
# local | development | staging | sandbox | production
NODE_ENV=local
PORT=3000
SECRET_KEY=

USE_LOGGER=true
USE_COMPRESSION=false
USE_LIMITER=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=6000

# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=express_drizzle
DB_POOL_MAX=10
DB_LOGGING=false
